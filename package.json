{
  "name": "hotspot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"try{require('fs').rmSync('.next/dev/lock')}catch(e){}\" && cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx scripts/seed-admin.ts",
    "db:seed:demo": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx scripts/seed-demo.ts",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.34.3",
    "jose": "^6.1.3",
    "lucide-react": "^0.575.0",
    "nanoid": "^5.1.6",
    "next": "16.1.6",
    "pg": "^8.18.0",
    "postgres": "^3.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.19.33",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
